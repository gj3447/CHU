# CQ1 어떤 사용자 발화가 어떤 작업을 촉발했고, 어느 저장소에 어떤 커밋을 남겼나
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX chu: <https://github.com/gj3447/CHU/vocab#>
SELECT ?activity ?title (GROUP_CONCAT(DISTINCT ?u; SEPARATOR=",") AS ?utterances)
       (GROUP_CONCAT(DISTINCT ?repo; SEPARATOR=",") AS ?repos) (COUNT(DISTINCT ?c) AS ?commits) WHERE {
  ?a a prov:Activity ; rdfs:label ?title ; prov:used ?utt .
  ?c a chu:Commit ; prov:wasGeneratedBy ?a ; chu:inRepository/rdfs:label ?repo .
  BIND(STRAFTER(STR(?a), "#") AS ?activity) BIND(STRAFTER(STR(?utt), "#") AS ?u)
} GROUP BY ?activity ?title ORDER BY ?activity
