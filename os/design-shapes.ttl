@prefix os: <https://github.com/gj3447/CHU/os#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

os:ClaimShape a sh:NodeShape ; sh:targetClass os:Requirement, os:Decision, os:Observation ;
    sh:property [ sh:path os:authority ; sh:hasValue "SECONDARY_AI" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:class prov:SoftwareAgent ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path skos:prefLabel ; sh:datatype xsd:string ; sh:minLength 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:nodeKind sh:IRI ; sh:class prov:Entity ; sh:minCount 1 ] .
os:RequirementShape a sh:NodeShape ; sh:targetClass os:Requirement ;
    sh:property [ sh:path os:plannedBy ; sh:class os:PlanTask ; sh:minCount 1 ] .
os:DecisionShape a sh:NodeShape ; sh:targetClass os:Decision ;
    sh:property [ sh:path os:status ; sh:hasValue "PROPOSED" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path os:addresses ; sh:class os:Requirement ; sh:minCount 1 ] ;
    sh:property [ sh:path os:proposes ; sh:class os:Strategy ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path os:alternative ; sh:class os:Strategy ; sh:disjoint os:proposes ; sh:minCount 1 ] .
os:StrategyShape a sh:NodeShape ; sh:targetClass os:Strategy ;
    sh:property [ sh:path skos:prefLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:class prov:Entity ; sh:nodeKind sh:IRI ; sh:minCount 1 ] .
os:ArtifactShape a sh:NodeShape ; sh:targetClass os:Artifact ;
    sh:nodeKind sh:IRI ; sh:pattern "^urn:sha256:[0-9a-f]{64}$" ;
    sh:property [ sh:path os:pathView ; sh:datatype xsd:string ; sh:minLength 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path os:authority ; sh:in ( "USER_PRIMARY" "SECONDARY_AI" ) ; sh:minCount 1 ; sh:maxCount 1 ] .
os:ObservationShape a sh:NodeShape ; sh:targetClass os:Observation ;
    sh:property [ sh:path os:claimScope ; sh:hasValue "CLEAN_BOOT_SUBSTRATE" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path os:reportsOn ; sh:hasValue os:R-SUBSTRATE ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path os:observedAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:class os:Artifact ; sh:minCount 1 ; sh:maxCount 1 ] .
os:TaskShape a sh:NodeShape ; sh:targetClass os:PlanTask ;
    sh:property [ sh:path os:taskStatus ; sh:in ( "done" "pending" ) ; sh:minCount 1 ; sh:maxCount 1 ] .
os:ReviewShape a sh:NodeShape ; sh:targetSubjectsOf os:reviewedOn ;
    sh:property [ sh:path os:reviewedOn ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .
