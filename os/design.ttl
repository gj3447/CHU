    os:reviewedOn "2026-10-02"^^xsd:date ; prov:wasAttributedTo os:research-agent ;
    skos:prefLabel "OS requirements, proposed experiment and bounded historical evidence" .
os:research-agent a prov:SoftwareAgent .

