    dev:requires dev:python, dev:rdflib, dev:pyshacl, dev:oxigraph ;
    dev:argv ( "{python}" "scripts/chu_repo.py" "check" "--out" "{out}" "--json" ) ;
    dev:effect "build" ; dev:timeout 120 ; dev:workingDirectory "repository-root" .
