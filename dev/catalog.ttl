@prefix dev: <https://github.com/gj3447/CHU/dev#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dev:catalog a prov:Entity ;
    rdfs:comment "Local CHU development configuration, not shared KG canon or execution authorization." ;
    rdfs:seeAlso <urn:symposium-kg:sym:Concept:computable_hyper_universe_(chu)> ;
    prov:wasAttributedTo dev:agent ;
    prov:wasDerivedFrom <https://www.w3.org/TR/prov-o/>,
        <https://www.w3.org/TR/rdf11-concepts/>,
        <https://www.w3.org/TR/shacl/>,
        <https://www.w3.org/TR/skos-reference/>,
        <https://www.w3.org/TR/sparql11-query/>,
        <https://www.w3.org/TR/swbp-n-aryRelations/> ;
    dev:authority "SECONDARY_AI" .

dev:ci-lint a dev:Check ;
    skos:prefLabel "Validate CI workflow" ;
    prov:wasDerivedFrom <https://github.com/rhysd/actionlint/blob/main/docs/usage.md> ;
    dev:argv ( ".chu/tools/actionlint" ".github/workflows/check.yml" ) ;
    dev:effect "read" ;
    dev:requires dev:actionlint ;
    dev:timeout 30 ;
    dev:workingDirectory "repository-root" .

dev:core-clippy a dev:Check ;
    skos:prefLabel "Check Rust with Clippy" ;
    prov:wasDerivedFrom <https://github.com/gj3447/CHU/blob/main/docs/DEVELOPMENT.md> ;
    dev:argv ( "cargo" "clippy" "--locked" "--offline" "--all-targets" "--" "-D" "warnings" ) ;
    dev:effect "build" ;
    dev:requires dev:rust ;
    dev:timeout 180 ;
    dev:workingDirectory "repository-root" .

dev:core-test a dev:Check ;
    skos:prefLabel "Execute native semantic assertions through cargo test" ;
    prov:wasDerivedFrom <https://github.com/gj3447/CHU/blob/main/docs/DEVELOPMENT.md> ;
    dev:argv ( "cargo" "test" "--locked" "--offline" ) ;
    dev:effect "build" ;
    dev:requires dev:rust ;
    dev:timeout 180 ;
    dev:workingDirectory "repository-root" .

dev:core-wasm a dev:Check ;
    skos:prefLabel "Compile WASM cdylib (compile gate only)" ;
    prov:wasDerivedFrom <https://github.com/gj3447/CHU/blob/main/docs/DEVELOPMENT.md> ;
    dev:argv ( "rustc" "--edition=2021" "--target" "wasm32-unknown-unknown" "--crate-type=cdylib" "-C" "panic=abort" "chu_core_prototype/chu_core.rs" "-o" "{out}/chu_core.wasm" ) ;
    dev:effect "build" ;
    dev:requires dev:rust ;
    dev:timeout 180 ;
    dev:workingDirectory "repository-root" .

dev:env-lock a dev:Check ;
    skos:prefLabel "Check dependency lock and installed environment" ;
    prov:wasDerivedFrom <https://github.com/gj3447/CHU/blob/main/docs/DEVELOPMENT.md> ;
    dev:argv ( "uv" "sync" "--locked" "--check" "--offline" ) ;
    dev:effect "read" ;
    dev:requires dev:uv ;
    dev:timeout 60 ;
    dev:workingDirectory "repository-root" .

dev:env-tools a dev:Check ;
    skos:prefLabel "Probe tool versions" ;
    prov:wasDerivedFrom <https://github.com/gj3447/CHU/blob/main/docs/DEVELOPMENT.md> ;
    dev:argv ( "{python}" "scripts/chu_dev.py" "doctor" "--json" ) ;
    dev:effect "read" ;
    dev:requires dev:actionlint,
        dev:lean,
        dev:pyshacl,
        dev:pytest,
        dev:python,
        dev:rdflib,
        dev:ruff,
        dev:rust,
        dev:uv ;
    dev:timeout 120 ;
    dev:workingDirectory "repository-root" .

dev:finite-panel a dev:Check ;
    skos:prefLabel "Run historical finite-panel example (not an infinite theorem proof)" ;
    prov:wasDerivedFrom <https://github.com/gj3447/CHU/blob/main/docs/DEVELOPMENT.md> ;
    dev:argv ( "{python}" "chu_core_prototype/ruliad_limit_closure_falsify.py" ) ;
    dev:effect "read" ;
    dev:requires dev:python ;
    dev:timeout 30 ;
    dev:workingDirectory "repository-root" .

dev:graph-assets a dev:Check ;
    skos:prefLabel "Validate existing RDF assets and portable host fixture" ;
    prov:wasDerivedFrom <https://github.com/gj3447/CHU/blob/main/docs/DEVELOPMENT.md> ;
    dev:argv ( "{python}" "scripts/check_graph_assets.py" ) ;
    dev:effect "read" ;
    dev:requires dev:pyshacl,
        dev:python,
        dev:rdflib ;
    dev:timeout 120 ;
    dev:workingDirectory "repository-root" .

dev:graph-catalog a dev:Check ;
