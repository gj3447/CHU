pc:C01 a rdf:Statement,
        prov:Entity,
        pc:Claim ;
    rdf:object pc:CHU ;
    rdf:predicate pc:computerImplementationOf ;
    rdf:subject pc:CHU_OS ;
    skos:prefLabel "CHU와 CHU_OS의 명명 구분" ;
    prov:wasAttributedTo pc:Codex ;
    prov:wasDerivedFrom pc:source-naming-20261012 ;
    pc:authority "SECONDARY_AI" ;
    pc:epistemicStatus "SOURCE_SUPPORTED" ;
    pc:kind "USER_NAMING" ;
    pc:sourceExcerpt "CHU_OS 랑 CHU 랑 분리해야함 cHU 는 그냥 그 인지능력체 그자체를 cHU 라고 부르는거같음 컴퓨터 기반으로 구현체가 CHU_OS 이고 ㅇㅇ 레포 분리도 해야할듯 내생각에는 그냥 우리 우주 자체도 월드모델 CHU 임" .

pc:C02 a rdf:Statement,
        prov:Entity,
        pc:Claim ;
    rdf:object <https://github.com/gj3447/CHU> ;
    rdf:predicate pc:separateRepositoryFrom ;
    rdf:subject <https://github.com/gj3447/CHU_OS> ;
    skos:prefLabel "철학을 먼저 정리하고 CHU_OS를 별도 저장소로 둔다" ;
    prov:wasAttributedTo pc:Codex ;
    prov:wasDerivedFrom pc:source-direction-20261012 ;
    pc:authority "SECONDARY_AI" ;
    pc:epistemicStatus "SOURCE_SUPPORTED" ;
    pc:kind "USER_DIRECTION" ;
    pc:sourceExcerpt "철학적 chu 를 일단 정리하고 그 os chy 는 CHU_OS 로 레포한게 따로파서 하는게 맞는거같은데 ㅇㅇ; 일단 CHU_OS 레포는 별개로 파는걸로 일다ㅣㄴ 알고있어주고 순서대로 쭉쭉 진행해줘볼래 ㅇㅇ?" .

